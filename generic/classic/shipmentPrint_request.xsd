<?xml version="1.0" encoding="UTF-8"?>
<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="ShipmentPrint" type="ShipmentPrintType"/>
  <xs:complexType name="HeaderType">
    <xs:all>
      <xs:element type="MessageId" name="MessageId" minOccurs="0" maxOccurs="1"/>
      <xs:element type="xs:dateTime" name="MessageDateTime" minOccurs="1" maxOccurs="1"/>
    </xs:all>
  </xs:complexType>
  <xs:simpleType name="MessageId">
    <xs:restriction base="xs:int">
      <xs:totalDigits value="100"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="PrintStationType">
    <xs:choice>
      <xs:element type="xs:string" name="Name"/>
      <xs:element type="ApplicationIdType" name="ID"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="PrintApplicationType">
    <xs:sequence>
      <xs:choice>
        <xs:element type="xs:string" name="Name"/>
        <xs:element type="ApplicationIdType" name="ID"/>
      </xs:choice>
      <xs:element type="PrintStationType" name="PrintStation" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="ApplicationIdType">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType>
        <xs:restriction base='xs:string'>
          <xs:length value="0"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:complexType name="ShipmentPackageType">
    <xs:choice>
      <xs:element name="Sequence" minOccurs="1" maxOccurs="1">
        <xs:simpleType>
          <xs:restriction base='xs:int' />
        </xs:simpleType>
      </xs:element>
      <xs:element type="xs:string" name="Reference" minOccurs="1" maxOccurs="1"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="ShipmentPackagesType">
    <xs:sequence>
      <xs:element type="ShipmentPackageType" name="ShipmentPackage" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShipmentType">
    <xs:sequence>
      <xs:choice>
        <xs:element type="xs:string" name="CodeShipment" minOccurs="1" maxOccurs="1"/>
        <xs:element type="xs:string" name="Reference" minOccurs="1" maxOccurs="1"/>
      </xs:choice>
      <xs:element type="ShipmentPackagesType" name="ShipmentPackages" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RequestedDocumentTypesType">
    <xs:sequence>
      <xs:element type="xs:boolean" name="AllRequiredDocuments" minOccurs="0" maxOccurs="1"/>
      <xs:element type="RequestedDocumentType" name="RequestedDocument" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="RequestedDocumentType">
    <xs:all>
      <xs:element type="xs:string" name="DocumentType" minOccurs="1" maxOccurs="1"/>
      <xs:element type="CopiesType" name="Copies" minOccurs="0" maxOccurs="1"/>
    </xs:all>
  </xs:complexType>
  <xs:simpleType name="CopiesType">
    <xs:restriction base="xs:int">
      <xs:minInclusive value="1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DocumentTypeEnum" final="restriction">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CarrierLabel" />
      <xs:enumeration value="ShippersLetterOfInstruction" />
      <xs:enumeration value="CertificateOfOrigin" />
      <xs:enumeration value="CommercialInvoiceV1" />
      <xs:enumeration value="CommercialInvoiceV3" />
      <xs:enumeration value="CMR" />
      <xs:enumeration value="CMRDummy" />
      <xs:enumeration value="CMRBE" />
      <xs:enumeration value="LithiumBatteries" />
      <xs:enumeration value="BillOfLading" />
      <xs:enumeration value="ConsolidatedInvoice" />
      <xs:enumeration value="InboundCollectionManifest" />
      <xs:enumeration value="ShippingManifest" />
      <xs:enumeration value="TntCustomsConnote" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="OrientationTypeEnum" final="restriction">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Portrait" />
      <xs:enumeration value="Landscape" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="DocumentType">
    <xs:annotation>
      <xs:documentation>
        Use one of the following combinations of fields to identify which document(s) should be printed:
        Combination 1: DocumentType --> this might result in multiple documents to be printed.
        Combination 2: DocumentType + Name
        Combination 3: Name --> this might result in multiple documents to be printed.
        Combination 4: Id
      </xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element type="xs:string" name="DocumentType" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>The allowed values are set in INSERT_SHIPMENT_DOCUMENTS_DOCUMENTTYPES parameter.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element type="xs:string" name="Name" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>The filename of the document that should be printed.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element type="xs:string" name="Id" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation>The Id of the document that should be printed.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element type="CopiesType" name="Copies" minOccurs="0" maxOccurs="1"/>
      <xs:element type="OrientationTypeEnum" name="PrintOrientation" minOccurs="0" maxOccurs="1" />
    </xs:all>
  </xs:complexType>
  <xs:simpleType name="ContentTypeEnum" final="restriction" >
    <xs:restriction base="xs:string">
      <xs:enumeration value="PDF" />
      <xs:enumeration value="PNG" />
      <xs:enumeration value="GIF" />
      <xs:enumeration value="JPG" />
      <xs:enumeration value="ZPL" />
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="DocumentsType">
    <xs:sequence>
      <xs:element type="DocumentType" name="Document" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PrintType">
    <xs:all>
      <xs:element type="PrintApplicationType" name="PrintApplication" minOccurs="0" maxOccurs="1"/>
      <xs:element type="ShipmentType" name="Shipment" minOccurs="1" maxOccurs="1"/>
      <xs:element type="RequestedDocumentTypesType" name="RequestedDocumentTypes" minOccurs="0" maxOccurs="1"/>
      <xs:element type="DocumentsType" name="Documents" minOccurs="0" maxOccurs="1"/>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="ShipmentPrintType">
    <xs:all>
      <xs:element type="HeaderType" name="Header" minOccurs="1" maxOccurs="1"/>
      <xs:element type="PrintType" name="Print" minOccurs="1" maxOccurs="1"/>
    </xs:all>
  </xs:complexType>
</xs:schema>
