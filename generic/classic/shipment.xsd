<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:element name="Shipment">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element name="Header" minOccurs="1" maxOccurs="1">
          <xs:complexType>
            <xs:choice maxOccurs="unbounded">
              <xs:element name="MessageId" minOccurs="1" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:int">
                    <xs:totalDigits value="100"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="MessageDateTime" minOccurs="1" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:dateTime"/>
                </xs:simpleType>
              </xs:element>
            </xs:choice>
          </xs:complexType>
        </xs:element>
        <xs:element name="ShipmentData" minOccurs="1" maxOccurs="1">
          <xs:complexType>
            <xs:all>
              <xs:element ref="Reference" minOccurs="1" maxOccurs="1"/>
              <xs:element name="SenderAddress" type="Address" minOccurs="0" maxOccurs="1"/>
              <xs:element name="ReceiverAddress" type="Address" minOccurs="1" maxOccurs="1"/>
              <xs:element name="DutiesTaxesAddress" type="Address" minOccurs="0" maxOccurs="1"/>
              <xs:element name="CollectionAddress" type="Address" minOccurs="0" maxOccurs="1"/>
              <xs:element name="ThirdPartyAddress" type="Address" minOccurs="0" maxOccurs="1"/>
              <xs:element name="UltimateAddress" type="Address" minOccurs="0" maxOccurs="1"/>
              <xs:element name="DropOffAddress" type="Address" minOccurs="0" maxOccurs="1"/>
              <xs:element name="BrokerAddress" type="Address" minOccurs="0" maxOccurs="1"/>
              <xs:element name="BuyerAddress" type="Address" minOccurs="0" maxOccurs="1"/>
              <xs:element name="ImporterOfRecordAddress" type="Address" minOccurs="0" maxOccurs="1"/>
              <xs:element name="VolumeUnit" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="cm"/>
                    <xs:enumeration value="inch"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="WeightUnit" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="kg"/>
                    <xs:enumeration value="lbs"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Description" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="350"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element ref="Value" minOccurs="0" maxOccurs="1"/>
              <xs:element name="CodeCurrencyValue" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:length value="3"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="DatePickup" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:date"/>
                </xs:simpleType>
              </xs:element>
              <xs:element name="TimePickup" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element ref="StartTime" minOccurs="1" maxOccurs="1"/>
                    <xs:element ref="EndTime" minOccurs="0" maxOccurs="1"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="CustomerServiceLevel" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="30"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="ServiceLevel" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="10"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="DeliveryCondition" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="20"/>
                    <xs:enumeration value="DD-CIP-PP"/>
                    <xs:enumeration value="DD-CPT-PP"/>
                    <xs:enumeration value="DD-DDP-PP"/>
                    <xs:enumeration value="DD-DAP-PP"/>
                    <xs:enumeration value="DD-DAT-PP"/>
                    <xs:enumeration value="DP-CIP-PP"/>
                    <xs:enumeration value="DP-CPT-PP"/>
                    <xs:enumeration value="DP-EXW-CC"/>
                    <xs:enumeration value="DP-FCA-CC"/>
                    <xs:enumeration value="DP-DAP-PP"/>
                    <xs:enumeration value="DP-DAT-PP"/>
                    <xs:enumeration value="DP-FOB-PP"/>
                    <xs:enumeration value="PP-CIF-PP"/>
                    <xs:enumeration value="PD-CIP-PP"/>
                    <xs:enumeration value="PD-CPT-PP"/>
                    <xs:enumeration value="PP-CIP-PP"/>
                    <xs:enumeration value="PP-CPT-PP"/>
                    <xs:enumeration value="KMSDY"/>
                    <xs:enumeration value="DP-CIF-PP"/>
                    <xs:enumeration value="DF-FOB-CC"/>
                    <xs:enumeration value="DP-CFR-PP"/>
                    <xs:enumeration value="DP-FAS-PP"/>
                    <xs:enumeration value="DD-DPU-PP"/>
                    <xs:enumeration value="DP-DPU-PP"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="DeliveryConditionDetailed" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:all>
                    <xs:element name="Incoterm" minOccurs="1" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="EXW"/>
                          <xs:enumeration value="FCA"/>
                          <xs:enumeration value="CPT"/>
                          <xs:enumeration value="CIP"/>
                          <xs:enumeration value="DAT"/>
                          <xs:enumeration value="DAP"/>
                          <xs:enumeration value="DDP"/>
                          <xs:enumeration value="DDU"/>
                          <xs:enumeration value="CIF"/>
                          <xs:enumeration value="FOB"/>
                          <xs:enumeration value="DPU"/>
                          <xs:enumeration value="FAS"/>
                          <xs:enumeration value="CFR"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Scope" minOccurs="1" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="DoorToDoor"/>
                          <xs:enumeration value="DoorToPort"/>
                          <xs:enumeration value="PortToDoor"/>
                          <xs:enumeration value="PortToPort"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Version" minOccurs="1" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="2000"/>
                          <xs:enumeration value="2010"/>
                          <xs:enumeration value="2020"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Place" type="xs:string" minOccurs="0" maxOccurs="1"/>
                    <xs:element name="Payment" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="Prepaid"/>
                          <xs:enumeration value="Collect"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                  </xs:all>
                </xs:complexType>
              </xs:element>
              <xs:element name="CustomerCarrierCode" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="30"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="CarrierCode" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="10"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Awb" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="30"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="DateDeliveryRequest" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:date"/>
                </xs:simpleType>
              </xs:element>
              <xs:element name="TimeDeliveryRequest" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element ref="StartTime" minOccurs="1" maxOccurs="1"/>
                    <xs:element ref="EndTime" minOccurs="0" maxOccurs="1"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="DateDeliveryPlan" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:union memberTypes="emptyDDP nonEmptyDDP"/>
                </xs:simpleType>
              </xs:element>
              <xs:element name="TimeDeliveryPlan" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element ref="StartTime" minOccurs="1" maxOccurs="1"/>
                    <xs:element ref="EndTime" minOccurs="0" maxOccurs="1"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="Prices" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element ref="Price" minOccurs="1" maxOccurs="3"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element name="CostCenter" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="20"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="CustomerCostCenter" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="50"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="Inbound" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="2"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="DeliveryId" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string"/>
                </xs:simpleType>
              </xs:element>
              <xs:element name="TariffType" minOccurs="0" maxOccurs="1">
                <xs:simpleType>
                  <xs:restriction base="xs:string"/>
                </xs:simpleType>
              </xs:element>
              <xs:element name="ServiceOptions" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:choice maxOccurs="unbounded">
                    <xs:element name="CargoArrangement" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="20"/>
                          <xs:enumeration value="PICKUP"/>
                          <xs:enumeration value="SELF DELIVERY"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Cod" minOccurs="0" maxOccurs="1">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element ref="Value" minOccurs="1" maxOccurs="1"/>
                          <xs:element ref="CodeCurrency" minOccurs="1" maxOccurs="1"/>
                          <xs:element name="Type" minOccurs="1" maxOccurs="1">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="CASH"/>
                                <xs:enumeration value="CHEQUE"/>
                                <xs:enumeration value="DRAFT"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="ConstructionSite" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="CustomClearance" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="DeliveryInside" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element ref="DangerousGoodsType" minOccurs="0" maxOccurs="1"/>
                    <xs:element minOccurs="0" maxOccurs="1" name="DgPackingInstructions" type="DgPackingInstructions"/>
                    <xs:element name="DocumentService" minOccurs="0" maxOccurs="1">
                      <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                          <xs:element name="DocumentServiceCode">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="ORIGINAL"/>
                                <xs:enumeration value="HOUSE"/>
                                <xs:enumeration value="TELEX"/>
                                <xs:enumeration value="FCR"/>
                                <xs:enumeration value="PICKUP"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="DocumentDate" minOccurs="0" maxOccurs="1">
                            <xs:simpleType>
                              <xs:restriction base="xs:date"/>
                            </xs:simpleType>
                          </xs:element>
                          <xs:element name="DocumentTime" minOccurs="0" maxOccurs="1">
                            <xs:simpleType>
                              <xs:restriction base="xs:time"/>
                            </xs:simpleType>
                          </xs:element>
                        </xs:choice>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="DryIceAudit" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="EquipmentTemperature" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="AMBIENT"/>
                          <xs:enumeration value="COOLED"/>
                          <xs:enumeration value="FROZEN"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="SurroundServiceCode" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="FEDEX_SURROUND_ELITE"/>
                          <xs:enumeration value="FEDEX_SURROUND_PREMIUM"/>
                          <xs:enumeration value="FEDEX_SURROUND_PREFERRED"/>
                          <xs:enumeration value="FEDEX_SURROUND_SELECT"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="FixedDeliveryDate" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="FixedDeliveryTime" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:union memberTypes="emptyFDT nonEmptyFDT"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Fragile" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="HoldForPickup" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="IndLithiumBatteries" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="IndNeutralDelivery" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="IndSaturdayDeliveryRequested" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Insurance" minOccurs="0" maxOccurs="1">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="InsuranceType" minOccurs="1" maxOccurs="2">
                            <xs:simpleType>
                              <xs:restriction base="xs:string">
                                <xs:enumeration value="RequestFromCarrier"/>
                                <xs:enumeration value="ReportingOnly"/>
                              </xs:restriction>
                            </xs:simpleType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="LiftGate" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="PickupPolicy" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="PRL"/>
                          <xs:enumeration value="FIXED"/>
                          <xs:enumeration value="ONE"/>
                          <xs:enumeration value="PAC1"/>
                          <xs:enumeration value="PAC3"/>
                          <xs:enumeration value="EXCHANGE"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ResidentialDelivery" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ScannedPodRequested" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="SmallVehicle" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Urgent" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="WhiteGlove" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:boolean"/>
                      </xs:simpleType>
                    </xs:element>
                  </xs:choice>
                </xs:complexType>
              </xs:element>
              <xs:element name="References" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:choice maxOccurs="unbounded">
                    <xs:element name="BolNumber" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ComplaintNumber" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="40"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ContainerNumber" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="40"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="CustomClearanceNumber" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="40"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="CustomerPoNr" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="40"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="FlightNumber" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="40"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="GlCode" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="40"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="InvoiceNumber" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="40"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="SapDelivery" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="20"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="RmaNumber" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="20"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="SapSoNr" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="20"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="ShipmentNumber" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="20"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="VerificationSheetNumber" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Voyage" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                  </xs:choice>
                </xs:complexType>
              </xs:element>
              <xs:element name="Instructions" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                  <xs:choice maxOccurs="unbounded">
                    <xs:element name="AirportFrom" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:length value="3"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="AirportTo" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:length value="3"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Branch" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="CancelDate" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:date"/>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element ref="CarrierInstruction" minOccurs="0" maxOccurs="1"/>
                    <xs:element name="DropoffId" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="40"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Justification" minOccurs="0" maxOccurs="1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="255"/>
                        </xs:restriction>
                      </xs:simpleType>
