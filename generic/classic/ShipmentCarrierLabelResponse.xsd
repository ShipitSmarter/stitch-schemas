      <xs:element minOccurs="0" maxOccurs="1" name="Shipment" type="ShipmentCarrierLabelResponseData" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ShipmentResponseHeader">
    <xs:sequence>
